{
  "info": {
    "name": "SwopMobile — offline fictional API checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only against api/tests/local-server.js. Fictional seeded credentials, never a production API. The expired JWT is signed with a public fixture-only key."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787"
    }
  ],
  "item": [
    {
      "name": "Local health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Local health\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid credentials input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":42,\"password\":\"short\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid credentials input\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "User login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"user@example.com\",\"password\":\"Password123!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"User login\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set('access',d.accessToken);pm.collectionVariables.set('refresh',d.refreshToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Protected profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{baseUrl}}/user/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Protected profile\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "User cannot list accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{baseUrl}}/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"User cannot list accounts\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Expired fixture token rejected",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user/me",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIyIiwidHlwZSI6ImFjY2VzcyIsInNpZCI6InN5bnRoZXRpYy1leHBpcmVkIiwiZXhwIjowfQ.HeGKUHOofaoFfeaxaqFfEYqy-fagXcBcairdTcosPaE"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Expired token returns 401',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create own fictional job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{baseUrl}}/jobs",
        "body": {
          "mode": "raw",
          "raw": "{\"company\":\"Fictional Co\",\"position\":\"Example engineer\",\"user_id\":1}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Create own fictional job\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('jobId',pm.response.json().job.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@example.com\",\"password\":\"Password123!\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin login\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminAccess',pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin can list accounts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccess}}"
          }
        ],
        "url": "{{baseUrl}}/admin/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin can list accounts\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Even admin cannot read another private job",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccess}}"
          }
        ],
        "url": "{{baseUrl}}/jobs/{{jobId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Even admin cannot read another private job\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Even admin cannot change another private job",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{adminAccess}}"
          }
        ],
        "url": "{{baseUrl}}/jobs/{{jobId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"company\":\"Changed\",\"position\":\"Example\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Even admin cannot change another private job\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "User can delete own fixture",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access}}"
          }
        ],
        "url": "{{baseUrl}}/jobs/{{jobId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"User can delete own fixture\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "User refreshes credentials",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/refresh",
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\":\"{{refresh}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"User refreshes credentials\", () => pm.response.to.have.status(200));",
              "const d=pm.response.json();pm.collectionVariables.set('access',d.accessToken);pm.collectionVariables.set('refresh',d.refreshToken);"
            ]
          }
        }
      ]
    },
