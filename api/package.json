{
  "name": "api",
  "version": "1.0.0",
  "description": "Cloudflare Worker API for Auth Service (Vanilla JavaScript)",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply auth-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply auth-db --local",
    "db:seed": "wrangler d1 execute auth-db --file=./seeds/dev-data.sql",
    "db:seed:local": "wrangler d1 execute auth-db --local --file=./seeds/dev-data.sql",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.150.0"
  }
}
